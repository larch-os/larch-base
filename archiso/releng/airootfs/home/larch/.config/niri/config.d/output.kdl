output "eDP-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    background-color "#000000"
    backdrop-color "#000000"
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    background-color "#000000"
    backdrop-color "#000000"
    position x=-1920 y=0
}